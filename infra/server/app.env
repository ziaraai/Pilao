# Settings of the server deployment, WITHOUT any secret (versioned, sent at every deploy).
# Secrets live in /opt/pilao/secrets.env on the server only (see deploy.sh).
# Changing a value here and pushing = the next deploy uses it.
ENVIRONMENT=production
APP_BASE_URL=https://app.pilao.pro
API_PUBLIC_URL=https://app.pilao.pro/api
STORAGE_BACKEND=disk
STORAGE_DIR=/data/files
REDIS_URL=redis://redis:6379/0
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
LOG_LEVEL=INFO

# AI: provisional until the phase 0 comparison (ADR-005); every call through OpenRouter
# avoids the providers that keep requests (LLM_DENY_DATA_COLLECTION, privacy policy)
LLM_MODEL_EXTRACTION=openrouter/anthropic/claude-haiku-5.5
LLM_MODEL_GENERATION=openrouter/anthropic/claude-haiku-5.5
LLM_MODEL_SCORING=openrouter/anthropic/claude-haiku-5.5
LLM_MODEL_VISION=openrouter/anthropic/claude-haiku-5.5
EMBEDDING_MODEL=openrouter/mistralai/mistral-embed-2312
EMBEDDING_DIM=1024
EMBEDDING_PRICE_USD_PER_MILLION=0.1
AI_MONTHLY_BUDGET_EUR_PER_ORG=50
USD_EUR_RATE=0.86
LLM_REASONING_TOKENS=8000
LLM_DENY_DATA_COLLECTION=true
LLM_ZERO_DATA_RETENTION=false

# Outgoing e-mail through the server's own mail system (Plesk: mailbox noreply@pilao.pro).
# Its certificate is the server's, not this name's: no TLS check on this hop, which never
# leaves the machine. Another provider (Brevo…): its host, port 587, SMTP_VERIFY_TLS=true.
SMTP_HOST=host.docker.internal
SMTP_PORT=587
SMTP_USER=noreply@pilao.pro
SMTP_FROM=Pilao <noreply@pilao.pro>
SMTP_STARTTLS=true
SMTP_VERIFY_TLS=false
# Team inbox for « Votre avis » (empty: stored only, see feedback-report)
FEEDBACK_EMAIL=
# Notices: TED every 2 hours; BOAMP once its reader is checked from here
# (/opt/pilao/pilao.sh exec api python -m app.cli import-tenders --source boamp --essai)
TED_IMPORT_ENABLED=true
BOAMP_IMPORT_ENABLED=false
TENDER_IMPORT_BACKFILL_DAYS=14
