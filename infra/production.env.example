# Copy to infra/production.env (not versioned) and fill in. The API refuses to start in
# production while a value below is still a development default (ADR-025).
ENVIRONMENT=production
APP_BASE_URL=https://app.example.fr
DATABASE_URL=postgresql+psycopg://pilao_app:CHANGE_ME@db.example.internal:5432/pilao
REDIS_URL=rediss://default:CHANGE_ME@redis.example.internal:6379/0
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_BUCKET=pilao-prod
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=fr-par
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# AI (LiteLLM model names, fixed after phase 0) and the provider key
LLM_MODEL_EXTRACTION=
LLM_MODEL_GENERATION=
LLM_MODEL_SCORING=
LLM_MODEL_VISION=
EMBEDDING_MODEL=
OPENROUTER_API_KEY=CHANGE_ME
AI_MONTHLY_BUDGET_EUR_PER_ORG=50
LOG_LEVEL=INFO
