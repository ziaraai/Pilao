DATABASE_URL=postgresql+psycopg://pilao:pilao@localhost:5432/pilao
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pilao-local
S3_ACCESS_KEY=pilao
S3_SECRET_KEY=pilao-secret
S3_REGION=fr-par
MAX_UPLOAD_BYTES=52428800
ORG_STORAGE_QUOTA_BYTES=5368709120
SIGNED_URL_TTL_SECONDS=300
# Antivirus (obligatoire en production, sinon les envois sont refusés)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Export PDF (worker) : LibreOffice headless (apt install libreoffice-writer-nogui)
SOFFICE_PATH=soffice
APP_SECRET_KEY=change-me
ENVIRONMENT=local   # local | test | production (active le cookie Secure)
APP_BASE_URL=http://localhost:3000
# Front (apps/web) : adresse de l'API vue par le navigateur, même site que APP_BASE_URL en production
NEXT_PUBLIC_API_URL=http://localhost:8000
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL_EXTRACTION=
LLM_MODEL_GENERATION=
LLM_MODEL_SCORING=
LLM_MODEL_VISION=
# Vide = embeddings factices (développement uniquement, refusé en production)
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
AI_MONTHLY_BUDGET_EUR_PER_ORG=50
# Les fournisseurs facturent en dollars : coût converti en euros dans `ai_calls`
USD_EUR_RATE=0.86
# Marge ajoutée à la longueur de chaque réponse : les modèles récents raisonnent avant (facturé)
LLM_REASONING_TOKENS=8000
BOAMP_BASE_URL=https://boamp-datadila.opendatasoft.com/api/explore/v2.1
TED_BASE_URL=https://api.ted.europa.eu/v3
RECHERCHE_ENTREPRISES_BASE_URL=https://recherche-entreprises.api.gouv.fr
